    "permutations": [
      {
        "condition": "q.block_state('orbital_foundry:depleted') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "of_deposit_copper_spent",
              "render_method": "opaque"
            },
            "rock": {
              "texture": "of_deposit_copper_spent",
              "render_method": "opaque"
            }
          }
        }
