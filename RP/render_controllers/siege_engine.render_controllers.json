{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.orbital_foundry.siege_engine": {
      "arrays": {
        "textures": {
          "Array.siege_skins": [
            "Texture.default",
            "Texture.left_broken",
            "Texture.right_broken",
            "Texture.both_broken"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.siege_skins[(1 - q.property('orbital_foundry:cool_l')) + 2 * (1 - q.property('orbital_foundry:cool_r'))]"
