        {
          "cool_l_fx": "!q.property('orbital_foundry:cool_l')"
        },
        {
          "cool_r": "q.property('orbital_foundry:cool_r')"
        },
        {
          "cool_r_broken": "!q.property('orbital_foundry:cool_r')"
        },
        {
          "cool_r_fx": "!q.property('orbital_foundry:cool_r')"
        },
        {
          "emitter_glow": "q.property('orbital_foundry:charging')"
